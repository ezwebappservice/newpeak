# Environment and secrets
.env
.env.*
!.env.example

# Composer
/vendor/

# CodeIgniter runtime
writable/cache/*
!writable/cache/index.html
!writable/cache/.htaccess

writable/logs/*
!writable/logs/index.html
!writable/logs/.htaccess

writable/session/*
!writable/session/index.html
!writable/session/.htaccess

writable/debugbar/*
!writable/debugbar/index.html
!writable/debugbar/.htaccess

writable/uploads/*
!writable/uploads/index.html
!writable/uploads/.htaccess

writable/investor_documents/*
!writable/investor_documents/index.html
!writable/investor_documents/.htaccess

writable/backups/*
!writable/backups/index.html
!writable/backups/.htaccess

# Tests and build output
phpunit.xml
phpunit.xml.bak
tests/coverage*
build/
.phpunit.cache/

